# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Environment
NEXT_PUBLIC_ENV=development

# Cross-application links
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Vercel AI Gateway. Unused until the agent layer lands; when it does, this is
# the only model credential the app needs — models are addressed as
# "provider/model" strings through the gateway rather than per-provider keys.
# A real secret: put the value in .env.local, never in a tracked .env.* file.
AI_GATEWAY_API_KEY=
